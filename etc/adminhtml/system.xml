<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="commercekings_abandoned_cart" translate="label" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Abandoned Cart</label>
            <tab>commercekings</tab>
            <resource>CommerceKings_AbandonedCart::config</resource>
            <group id="general" translate="label comment" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Cart reminders</label>
                <fieldset_css>commercekings-config-section</fieldset_css>
                <comment>Send one reminder per cart, with consent.</comment>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="delay_minutes" translate="label comment" type="text" sortOrder="20" showInDefault="1">
                    <label>Inactivity delay (minutes)</label>
                    <comment>Wait after the last cart or email update. 180 = 3 hours.</comment>
                    <validate>validate-digits validate-greater-than-zero</validate>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="max_pending" translate="label comment" type="text" sortOrder="22" showInDefault="1">
                    <label>Maximum pending reminders</label>
                    <comment>Carts queued but not sent yet. The finder tops the queue up to this every minute, so more consumers send faster without other changes. 2000 suits most shops.</comment>
                    <validate>required-entry validate-digits validate-greater-than-zero</validate>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="max_per_hour" translate="label comment" type="text" sortOrder="24" showInDefault="1">
                    <label>Maximum reminders per hour</label>
                    <comment>Set to your email provider's sending limit. 0 = no limit. Carts over the limit wait for the next hour; none are lost.</comment>
                    <validate>validate-digits</validate>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="quote_lifetime" translate="label comment" type="label" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Cart lifetime (days)</label>
                    <frontend_model>CommerceKings\AbandonedCart\Block\Adminhtml\System\Config\QuoteLifetime</frontend_model>
                    <comment>Uses Magento's Quote Lifetime setting. Read-only.</comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="reminders_per_cart" translate="label comment" type="label" sortOrder="35" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Reminders per cart</label>
                    <frontend_model>CommerceKings\AbandonedCart\Block\Adminhtml\System\Config\ReminderPolicy</frontend_model>
                    <comment>Set by the reminder policy. Read-only.</comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="template" translate="label" type="select" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Email template</label>
                    <source_model>Magento\Config\Model\Config\Source\Email\Template</source_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="identity" translate="label" type="select" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Sender</label>
                    <source_model>Magento\Config\Model\Config\Source\Email\Identity</source_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
            </group>
        </section>
    </system>
</config>
