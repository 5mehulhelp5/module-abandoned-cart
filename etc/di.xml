<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="CommerceKings\AbandonedCart\Api\ReminderEmailResolverInterface" type="CommerceKings\AbandonedCart\Model\ReminderEmailResolver"/>
    <!-- the unsubscribe link in reminders; replace for any link format (default: the permission's link - with the
         consent bridge Consent's signed page; none without a permission module) -->
    <preference for="CommerceKings\AbandonedCart\Api\UnsubscribeLinkInterface" type="CommerceKings\AbandonedCart\Model\PermissionUnsubscribeLink"/>
    <preference for="CommerceKings\AbandonedCart\Api\ReminderPolicyInterface" type="CommerceKings\AbandonedCart\Model\ReminderPolicy\OncePerCart"/>
    <!-- sending: CommerceKings_Notification's shared queue consumer hands the cart's subscription id to this type -->
    <type name="CommerceKings\Notification\Model\TypePool">
        <arguments>
            <argument name="types" xsi:type="array">
                <item name="cart_reminder" xsi:type="object">CommerceKings\AbandonedCart\Model\Notification\CartReminder</item>
            </argument>
        </arguments>
    </type>
    <!-- who may subscribe a cart (CommerceKings_Notification does email, consent and storage) -->
    <type name="CommerceKings\Notification\Model\SubscriptionTypePool">
        <arguments>
            <argument name="types" xsi:type="array">
                <item name="cart_reminder" xsi:type="object">CommerceKings\AbandonedCart\Model\Notification\CartSubscription</item>
            </argument>
        </arguments>
    </type>
    <!-- the consent purpose this feature uses (CommerceKings_Consent) - any consent source can grant it -->
    <type name="CommerceKings\Consent\Model\PurposePool">
        <arguments>
            <argument name="purposes" xsi:type="array">
                <item name="cart_reminder" xsi:type="array">
                    <item name="label" xsi:type="string">Abandoned cart reminder</item>
                    <!-- raise when what the visitor agrees to changes: older consents stop counting -->
                    <item name="terms_revision" xsi:type="string">1</item>
                </item>
            </argument>
        </arguments>
    </type>
</config>
