<?xml version="1.0"?>
<!-- Abandoned cart send history per cart, next to Magento's cart (quote). Who subscribed, with which consent,
     is the cart's CommerceKings_Notification subscription. -->
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="ck_abandoned_cart" resource="checkout" engine="innodb" comment="CK abandoned cart: send history per cart">
        <column xsi:type="int" name="quote_id" unsigned="true" nullable="false" comment="Cart (quote) ID"/>
        <column xsi:type="timestamp" name="queued_at" on_update="false" nullable="true" comment="Reminder queued"/>
        <column xsi:type="timestamp" name="reminded_at" on_update="false" nullable="true" comment="Reminder sent"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="quote_id"/>
        </constraint>
        <!-- Magento's quote cleanup removes the send history with the cart -->
        <constraint xsi:type="foreign" referenceId="CK_ABANDONED_CART_QUOTE_ID_QUOTE_ENTITY_ID"
                    table="ck_abandoned_cart" column="quote_id" referenceTable="quote"
                    referenceColumn="entity_id" onDelete="CASCADE"/>
        <index referenceId="CK_ABANDONED_CART_QUEUED_AT" indexType="btree">
            <column name="queued_at"/>
        </index>
    </table>
</schema>
