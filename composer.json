{
    "name": "commercekings/module-abandoned-cart",
    "description": "Privacy-first abandoned cart reminder for Magento 2: consent per purpose (commercekings/module-consent), Magento message queue, signed links, opt-out.",
    "type": "magento2-module",
    "license": "MIT",
    "authors": [
        {
            "name": "CommerceKings"
        }
    ],
    "require": {
        "php": "~8.1.0||~8.2.0||~8.3.0||~8.4.0||~8.5.0",
        "magento/framework": "^103.0",
        "magento/module-quote": "^101.2",
        "magento/module-checkout": "^100.4",
        "commercekings/module-core": "^0.1",
        "commercekings/module-consent": "^0.1",
        "commercekings/module-notification": "^0.1",
        "magento/module-catalog": "^104.0",
        "magento/module-customer": "^103.0",
        "magento/module-config": "^101.2",
        "magento/module-backend": "^102.0"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "CommerceKings\\AbandonedCart\\": ""
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "archive": {
        "exclude": [
            "/Test/",
            "/.github/",
            "/.gitignore",
            "/.gitattributes"
        ]
    },
    "homepage": "https://github.com/commercekings/module-abandoned-cart",
    "support": {
        "issues": "https://github.com/commercekings/module-abandoned-cart/issues",
        "source": "https://github.com/commercekings/module-abandoned-cart"
    }
}
