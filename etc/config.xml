<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <commercekings_abandoned_cart>
            <general>
                <enabled>0</enabled>
                <delay_minutes>180</delay_minutes>
                <max_per_hour>100</max_per_hour>
                <template>commercekings_abandoned_cart_general_template</template>
                <identity>general</identity>
            </general>
            <notice>
                <show>auto</show>
                <text>If you leave your cart, we may email you one reminder about it.</text>
            </notice>
        </commercekings_abandoned_cart>
    </default>
</config>
