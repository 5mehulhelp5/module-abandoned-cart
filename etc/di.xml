<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="CommerceKings\AbandonedCart\Api\GuestEmailCaptureInterface" type="CommerceKings\AbandonedCart\Model\GuestEmailCapture"/>
    <preference for="CommerceKings\AbandonedCart\Api\ReminderEmailResolverInterface" type="CommerceKings\AbandonedCart\Model\ReminderEmailResolver"/>
    <type name="CommerceKings\AbandonedCart\Api\GuestEmailCaptureInterface">
        <plugin name="ck_abandoned_cart_validate_guest_email"
                type="CommerceKings\AbandonedCart\Plugin\ValidateGuestEmailCapture" sortOrder="10"/>
    </type>
    <virtualType name="CommerceKingsAbandonedCartEmailLength" type="Magento\Framework\Validator\StringLength">
        <arguments>
            <argument name="options" xsi:type="array">
                <item name="max" xsi:type="number">255</item>
            </argument>
        </arguments>
    </virtualType>
    <type name="CommerceKings\AbandonedCart\Plugin\ValidateGuestEmailCapture">
        <arguments>
            <argument name="emailLengthValidator" xsi:type="object">CommerceKingsAbandonedCartEmailLength</argument>
        </arguments>
    </type>
    <preference for="CommerceKings\AbandonedCart\Api\ReminderPolicyInterface" type="CommerceKings\AbandonedCart\Model\ReminderPolicy\OncePerCart"/>
    <type name="CommerceKings\Consent\Model\WithdrawalPool">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="cart_reminder" xsi:type="array">
                    <item name="abandoned_cart" xsi:type="object">CommerceKings\AbandonedCart\Model\WithdrawalHandler</item>
                </item>
            </argument>
        </arguments>
    </type>
    <!-- sending: CommerceKings_Notification's shared queue consumer hands cart ids to this type -->
    <type name="CommerceKings\Notification\Model\TypePool">
        <arguments>
            <argument name="types" xsi:type="array">
                <item name="cart_reminder" xsi:type="object">CommerceKings\AbandonedCart\Model\Notification\CartReminder</item>
            </argument>
        </arguments>
    </type>
    <!-- the consent purpose this feature uses (CommerceKings_Consent) - any consent source can grant it -->
    <type name="CommerceKings\Consent\Model\PurposePool">
        <arguments>
            <argument name="purposes" xsi:type="array">
                <item name="cart_reminder" xsi:type="array">
                    <item name="label" xsi:type="string">Abandoned cart reminder</item>
                    <!-- raise when what the visitor agrees to changes: older consents stop counting -->
                    <item name="terms_revision" xsi:type="string">1</item>
                </item>
            </argument>
        </arguments>
    </type>
</config>
