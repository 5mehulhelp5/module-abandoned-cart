<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="CommerceKings\AbandonedCart\Api\ReminderEmailResolverInterface" type="CommerceKings\AbandonedCart\Model\ReminderEmailResolver"/>
    <!-- the unsubscribe link in reminders; replace for any link format (default: the subscriber's link - with the
         consent bridge Consent's signed page; none without a permission module) -->
    <preference for="CommerceKings\AbandonedCart\Api\UnsubscribeLinkInterface" type="CommerceKings\AbandonedCart\Model\SubscriberUnsubscribeLink"/>
    <preference for="CommerceKings\AbandonedCart\Api\ReminderPolicyInterface" type="CommerceKings\AbandonedCart\Model\ReminderPolicy\OncePerCart"/>
    <preference for="CommerceKings\AbandonedCart\Api\CartDataInterface" type="CommerceKings\AbandonedCart\Model\ReminderData"/>
    <preference for="CommerceKings\AbandonedCart\Api\RestoreLinkInterface" type="CommerceKings\AbandonedCart\Model\RestoreLink"/>
    <!-- the reminders the finder queues, one per channel (argument "types": code => ReminderTypeInterface); email is
         built in, a channel module adds its own here and wires the two virtual types below (docs/extending.md) -->
    <type name="CommerceKings\AbandonedCart\Model\ReminderTypePool">
        <arguments>
            <argument name="types" xsi:type="array">
                <item name="cart_reminder" xsi:type="object">CommerceKings\AbandonedCart\Model\Reminder\EmailReminder</item>
            </argument>
        </arguments>
    </type>
    <!-- the email reminder: this module's settings, template and the cart's email; its email data lazily, because
         Notification's subscription types are built from it (CartSubscription) -->
    <type name="CommerceKings\AbandonedCart\Model\Reminder\EmailReminder">
        <arguments>
            <argument name="reminderData" xsi:type="object">CommerceKings\AbandonedCart\Model\ReminderData\Proxy</argument>
        </arguments>
    </type>
    <type name="CommerceKings\AbandonedCart\Model\Notification\CartReminder">
        <arguments>
            <argument name="type" xsi:type="object">CommerceKings\AbandonedCart\Model\Reminder\EmailReminder</argument>
        </arguments>
    </type>
    <type name="CommerceKings\AbandonedCart\Model\Notification\CartSubscription">
        <arguments>
            <argument name="type" xsi:type="object">CommerceKings\AbandonedCart\Model\Reminder\EmailReminder</argument>
        </arguments>
    </type>
    <!-- sending: CommerceKings_Notification's shared queue consumer hands the cart's subscription id to this type -->
    <type name="CommerceKings\Notification\Model\TypePool">
        <arguments>
            <argument name="types" xsi:type="array">
                <item name="cart_reminder" xsi:type="object">CommerceKings\AbandonedCart\Model\Notification\CartReminder</item>
            </argument>
        </arguments>
    </type>
    <!-- who may subscribe a cart (CommerceKings_Notification does email, consent and storage) -->
    <type name="CommerceKings\Notification\Model\SubscriptionTypePool">
        <arguments>
            <argument name="types" xsi:type="array">
                <item name="cart_reminder" xsi:type="object">CommerceKings\AbandonedCart\Model\Notification\CartSubscription</item>
            </argument>
        </arguments>
    </type>
    <!-- the consent purpose this feature uses (CommerceKings_Consent) - any consent source can grant it; active only
         with the consent bridge, so without it (opt-out) the banner shows no reminder switch. Without Consent installed
         Magento ignores this entry (checked: setup:di:compile passes with the Consent modules disabled). -->
    <type name="CommerceKings\Consent\Model\PurposePool">
        <arguments>
            <argument name="purposes" xsi:type="array">
                <item name="cart_reminder" xsi:type="array">
                    <item name="label" xsi:type="string">Abandoned cart reminder</item>
                    <!-- raise when what the visitor agrees to changes: older consents stop counting -->
                    <item name="terms_revision" xsi:type="string">1</item>
                    <!-- the default banner category (CommerceKings_ConsentDefaults) -->
                    <item name="category" xsi:type="string">personalization</item>
                    <item name="active_if" xsi:type="array">
                        <item name="consent_bridge" xsi:type="string">commercekings_consent_notification/general/enabled</item>
                    </item>
                </item>
            </argument>
        </arguments>
    </type>
    <!-- the cart reminder's subscriber: its type's own, else the shop-wide one (Notification's TypeSubscriber) -->
    <virtualType name="CommerceKingsCartReminderSubscriber" type="CommerceKings\Notification\Model\TypeSubscriber">
        <arguments>
            <argument name="typeCode" xsi:type="string">cart_reminder</argument>
        </arguments>
    </virtualType>
    <type name="CommerceKings\AbandonedCart\Model\RestoreAccess">
        <arguments>
            <argument name="subscriber" xsi:type="object">CommerceKingsCartReminderSubscriber</argument>
        </arguments>
    </type>
    <type name="CommerceKings\AbandonedCart\Model\RestoreLink">
        <arguments>
            <argument name="subscriber" xsi:type="object">CommerceKingsCartReminderSubscriber</argument>
        </arguments>
    </type>
    <type name="CommerceKings\AbandonedCart\Model\SubscriberUnsubscribeLink">
        <arguments>
            <argument name="subscriber" xsi:type="object">CommerceKingsCartReminderSubscriber</argument>
        </arguments>
    </type>
</config>
