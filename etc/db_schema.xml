     (ck_notification_delivery_state, type cart_reminder, reference the quote id). ck_abandoned_cart stays in
     db_schema_whitelist.json so setup:upgrade drops it where an earlier build created it. -->
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
</schema>
